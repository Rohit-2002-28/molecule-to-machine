{
  "name": "molecule-to-machine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An independent, source-grounded interactive quantum chemistry course.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:browser": "playwright test",
    "validate:content": "tsx scripts/validate-course.ts",
    "validate:release": "tsx scripts/validate-course.ts --release",
    "validate:links": "tsx scripts/validate-links.ts",
    "verify": "npm run validate:release && npm run check && npm test && npm run build && npm run validate:links && npm run test:browser"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.8",
    "astro": "^7.3.3",
    "katex": "^0.18.7",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
