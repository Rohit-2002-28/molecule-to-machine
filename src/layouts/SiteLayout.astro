---
import Curriculum from '../components/Curriculum.astro';
import { BASE, course } from '../lib/course';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-serif-4';
import 'katex/dist/katex.min.css';
import '../styles/site.css';
interface Props { title?: string; description?: string; lesson?: number; wide?: boolean }
const { title, description = 'A complete, independent technical course connecting molecular chemistry, quantum algorithms, and resource estimation.', lesson, wide = false } = Astro.props;
const pageTitle = title ? `${title} | From Molecule to Machine` : 'From Molecule to Machine | An interactive quantum chemistry course';
const canonical = new URL(Astro.url.pathname.endsWith('/404/') ? `${BASE}404.html` : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#2457c5" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <script is:inline>
      try {
        const choice = localStorage.getItem('molecule-to-machine:theme');
        if (choice === 'dark' || choice === 'light') document.documentElement.dataset.theme = choice;
      } catch { document.documentElement.dataset.storageUnavailable = 'true'; }
    </script>
  </head>
  <body data-current-lesson={lesson} data-lesson-count={course.lessons.length} data-base={BASE}>
    <!--
    THESIS: A complete scientific course with explorable explanatory plates, not a marketing dashboard.
    OWN-WORLD: Cool paper, cobalt index tabs, ink-blue type, numbered vector plates, native controls.
    STORY: Define a chemical question, follow each representation, inspect assumptions, and read the full source-grounded lesson.
    FIRST VIEWPORT: A persistent curriculum rail, generous reading column, precise concept plate, and quiet section index. Start or continue is a direct chapter link.
    FORM: Scientific atlas, grounded candidate 5; anchored original text and explicitly supplementary learning; seed 32a7066d. User approved this direction.
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={BASE} aria-label="From Molecule to Machine, course home">
        <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><path d="M8 9 L25 17 L8 26" /><circle cx="8" cy="9" r="4" /><circle cx="25" cy="17" r="4" /><circle cx="8" cy="26" r="4" /></svg>
        <span>Molecule<br /><strong>to Machine</strong></span>
      </a>
      <nav class="header-links" aria-label="Main navigation"><a href={BASE}>Course</a><a href={`${BASE}glossary/`}>Glossary</a><a href={`${BASE}about/`}>About</a></nav>
      <div class="header-tools">
        <button class="search-trigger" data-open-search aria-label="Search course" aria-haspopup="dialog" disabled><svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8" cy="8" r="5.5" /><path d="M12 12 L18 18" /></svg><span>Search course</span><kbd>/</kbd></button>
        <label class="theme-control"><span class="sr-only">Color theme</span><select aria-label="Color theme" data-theme-control><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label>
        <button class="icon-button mobile-menu" data-open-curriculum aria-label="Open curriculum" aria-haspopup="dialog" disabled><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6 H20 M4 12 H20 M4 18 H20" /></svg></button>
      </div>
    </header>
    <aside class="sidebar">
      <div class="sidebar-heading"><a href={`${BASE}#curriculum`}>The complete journey</a><span>{course.lessons.length} lessons</span></div>
      <div class="reading-status"><span data-progress-count>0 of {course.lessons.length} read</span><progress data-course-progress max={course.lessons.length} value="0" aria-label="Lessons marked as read"></progress></div>
      <Curriculum current={lesson} />
      <div class="sidebar-footer"><a href={`${BASE}saved/`}>Saved lessons &amp; progress</a><p>Independent learning.<br />No account. No tracking.</p></div>
    </aside>
    <div class:list={['page-frame', { wide }]}>
      <main id="main" tabindex="-1"><slot /></main>
      <slot name="toc" />
      <footer class="site-footer"><span>From Molecule to Machine</span><p>An independent educational project. Not affiliated with or endorsed by Microsoft.</p><a href={`${BASE}about/#sources-and-attribution`}>Sources &amp; attribution</a><a href={`${BASE}saved/`}>Your local data</a></footer>
    </div>
    <dialog class="curriculum-dialog" aria-labelledby="mobile-curriculum-title">
      <div class="dialog-heading"><h2 id="mobile-curriculum-title">The complete journey</h2><button class="icon-button" data-close-dialog aria-label="Close curriculum">×</button></div>
      <div class="mobile-utility"><a href={BASE}>Course home</a><a href={`${BASE}glossary/`}>Glossary</a><a href={`${BASE}saved/`}>Saved</a><a href={`${BASE}about/`}>About</a></div>
      <Curriculum current={lesson} />
    </dialog>
    <dialog class="search-dialog" aria-labelledby="search-title">
      <div class="dialog-heading"><h2 id="search-title">Search the course</h2><button class="icon-button" data-close-dialog aria-label="Close search">×</button></div>
      <label for="course-search">Find a concept, method, or phrase</label><input id="course-search" type="search" placeholder="Try active space, covariance, or QPE..." autocomplete="off" />
      <p class="search-status" role="status">Search titles and the full lesson text.</p><ol class="search-results"></ol>
      <p class="dialog-hint">Tab to a result, Enter to open. Escape closes search.</p>
    </dialog>
    <div class="storage-toast" role="status" hidden></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
