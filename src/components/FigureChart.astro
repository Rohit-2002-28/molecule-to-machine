---
import { plotCoordinate, plotFrame, pointPosition, seriesPath, type PlotSpec } from '../lib/plot-data';
interface Props { spec: PlotSpec; id: string; title: string; compact: boolean }
const { spec, id, title, compact } = Astro.props;
const frame = plotFrame(compact);
const suffix = compact ? 'compact' : 'wide';
const clipId = `${id}-${suffix}-clip`;
const chartId = `${id}-${suffix}-chart`;
const cursor = spec.cursor ? pointPosition(spec.cursor, spec, frame) : null;
const xTicks = compact && spec.x.ticks.length > 5
  ? spec.x.ticks.filter((_, index) => index % 2 === 0 || index === spec.x.ticks.length - 1) : spec.x.ticks;
---
<svg class:list={['figure-chart', compact ? 'chart-compact' : 'chart-wide']} data-compact={String(compact)} viewBox={`0 0 ${frame.width} ${frame.height}`} role="img" aria-labelledby={`${chartId}-title ${chartId}-description`}>
  <title id={`${chartId}-title`}>{title}</title>
  <desc id={`${chartId}-description`}>{spec.y.label} versus {spec.x.label}. {spec.series.map(item => item.name).join('; ')}. Exact assumptions and selected numerical values follow this plot.</desc>
  <defs><clipPath id={clipId}><rect x={frame.left - 7} y={frame.top - 7} width={frame.right - frame.left + 14} height={frame.bottom - frame.top + 14} /></clipPath></defs>
  {spec.y.ticks.map(tick => {
    const y = plotCoordinate(tick.value, spec.y, frame.bottom, frame.top);
    return <g class="chart-tick"><path class="chart-grid" d={`M${frame.left},${y}H${frame.right}`} /><text x={frame.left - 10} y={y + 5} text-anchor="end">{tick.label}</text></g>;
  })}
  {xTicks.map(tick => {
    const x = plotCoordinate(tick.value, spec.x, frame.left, frame.right);
    return <g class="chart-tick"><path class="chart-axis" d={`M${x},${frame.bottom}v5`} /><text x={x} y={frame.bottom + 25} text-anchor="middle">{tick.label}</text></g>;
  })}
  <path class="chart-axis" d={`M${frame.left},${frame.top}V${frame.bottom}H${frame.right}`} />
  <g clip-path={`url(#${clipId})`}>
    {spec.reference?.map(reference => {
      const position = reference.axis === 'x'
        ? plotCoordinate(reference.value, spec.x, frame.left, frame.right)
        : plotCoordinate(reference.value, spec.y, frame.bottom, frame.top);
      return <path class="chart-reference" data-reference={reference.axis} d={reference.axis === 'x' ? `M${position},${frame.top}V${frame.bottom}` : `M${frame.left},${position}H${frame.right}`} />;
    })}
    {spec.series.map((item, index) => <g class:list={['chart-series', `series-${item.tone}`, { 'series-dashed': item.dashed }]} data-series={index}>
      {item.mode !== 'points' && <path class:list={['series-path', { 'series-bars': item.mode === 'bars' }]} d={seriesPath(item, spec, frame)} />}
      {(item.mode === 'points' || item.mode === 'line' && item.points.length < 18) && item.points.map(point => {
        const p = pointPosition(point, spec, frame);
        return <g><circle cx={p.x} cy={p.y} r={compact ? 4.5 : 5} data-candidate={point.label} />{point.label && <text class="point-label" x={p.x + 9} y={p.y - 9}>{point.label}</text>}</g>;
      })}
    </g>)}
    {cursor && <g class="chart-cursor">
      <path data-cursor-guide d={`M${cursor.x},${frame.bottom}V${cursor.y}`} />
      <circle data-cursor cx={cursor.x} cy={cursor.y} r="6" />
    </g>}
  </g>
  {spec.annotations?.map(annotation => {
    const point = pointPosition(annotation.point, spec, frame);
    const label = pointPosition(annotation.labelAt, spec, frame);
    return <g class="chart-annotation"><path d={`M${point.x},${point.y}L${label.x},${label.y + 6}`} /><text x={label.x} y={label.y}>{annotation.label}</text></g>;
  })}
</svg>
