---
import type { Learning } from '../data/learning';
interface Props { number: number; plate: Learning['plate'] }
const { number, plate } = Astro.props;
const marker = `arrow-${number}`;
const arrow = `url(#${marker})`;
const label = `plate-title-${number}`;
const description = `plate-description-${number}`;
const columns = [90, 245, 400, 555];
const bits = [1, 0, 1, 0];
---
<figure class="concept-plate" aria-labelledby={label}>
  <div class="plate-heading">
    <h2 id={label}>{plate.title}</h2>
    <span>Concept plate {String(number).padStart(2, '0')}</span>
  </div>
  <div class="diagram-scroll" tabindex="0" role="region" aria-label={`Scrollable diagram: ${plate.title}`}>
    <svg class="diagram" viewBox="0 0 640 250" role="img" aria-labelledby={`${label} ${description}`}>
      <defs>
        <marker id={marker} markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L0,6 L6,3 Z" fill="currentColor" stroke="none" /></marker>
      </defs>
      {plate.kind === 'bond' && <g>
        <path class="soft-line" d="M55 128 H580" />
        <ellipse class="cloud" cx="235" cy="115" rx="102" ry="65" />
        <ellipse class="cloud" cx="400" cy="115" rx="102" ry="65" />
        <circle class="filled" cx="235" cy="115" r="27" /><circle class="filled" cx="400" cy="115" r="27" />
        <text class="on-fill" x="235" y="122" text-anchor="middle">N</text><text class="on-fill" x="400" y="122" text-anchor="middle">N</text>
        <path class="ink-line" d="M235 186 V200 M235 193 H400 M400 186 V200" />
        <text x="318" y="226" text-anchor="middle">R: specified nuclear separation</text>
        <text x="318" y="32" text-anchor="middle">Geometry + electronic model + target accuracy</text>
      </g>}
      {plate.kind === 'orbitals' && <g>
        {[0, 1, 2].map((row) => <g>
          <text x="45" y={66 + row * 65}>Orbital {row + 1}</text>
          <path class="ink-line" d={`M180 ${76 + row * 65} H280 M335 ${76 + row * 65} H435`} />
          {row < 2 && <path class="accent-line" marker-end={arrow} d={`M215 ${70 + row * 65} V${38 + row * 65}`} />}
          {row === 0 && <path class="accent-line" marker-end={arrow} d={`M385 40 V70`} />}
        </g>)}
        <text x="225" y="238" text-anchor="middle">alpha modes</text><text x="385" y="238" text-anchor="middle">beta modes</text>
        <text x="495" y="86">Occupied</text><text x="495" y="112">or empty</text><text x="495" y="172">Never a</text><text x="495" y="198">trajectory</text>
      </g>}
      {plate.kind === 'contracts' && <g>
        {['Molecule', 'Algorithm', 'State'].map((text, index) => <g>
          <rect class={index === 1 ? 'tinted' : 'paper'} x={35 + index * 210} y="70" width="150" height="85" rx="4" />
          <text x={110 + index * 210} y="120" text-anchor="middle">{text}</text>
          {index < 2 && <path class="accent-line" marker-end={arrow} d={`M${185 + index * 210} 112 H${238 + index * 210}`} />}
        </g>)}
        <text x="110" y="190" text-anchor="middle">Typed input</text><text x="320" y="190" text-anchor="middle">Settings + method</text><text x="530" y="190" text-anchor="middle">Capabilities</text>
        <text x="320" y="35" text-anchor="middle">Meaning travels across the API boundary</text>
      </g>}
      {plate.kind === 'basis' && <g>
        {[140, 480].map(x => <g>
          <ellipse class="cloud" cx={x} cy="120" rx="75" ry="75" /><ellipse class="tinted" cx={x - 34} cy="120" rx="34" ry="20" />
          <ellipse class="tinted" cx={x + 34} cy="120" rx="34" ry="20" /><circle class="filled" cx={x} cy="120" r="8" />
        </g>)}
        <path class="accent-line" d="M245 115 H380" marker-end={arrow} />
        <text x="320" y="90" text-anchor="middle">linear combinations</text>
        <text x="140" y="225" text-anchor="middle">Atom-centered functions</text><text x="480" y="225" text-anchor="middle">Molecular orbitals</text>
      </g>}
      {plate.kind === 'loop' && <g>
        <path class="accent-line" d="M190 72 H433" marker-end={arrow} /><path class="accent-line" d="M500 99 V170" marker-end={arrow} />
        <path class="accent-line" d="M444 192 H197" marker-end={arrow} /><path class="accent-line" d="M140 168 V100" marker-end={arrow} />
        {[{ x: 140, y: 70, text: 'Density' }, { x: 500, y: 70, text: 'Mean field' }, { x: 500, y: 193, text: 'Orbitals' }, { x: 140, y: 193, text: 'Residual' }].map(item => <g>
          <rect class="paper" x={item.x - 77} y={item.y - 25} width="154" height="50" rx="4" /><text x={item.x} y={item.y + 6} text-anchor="middle">{item.text}</text>
        </g>)}
        <text x="320" y="128" text-anchor="middle">Iterate to</text><text x="320" y="155" text-anchor="middle">self-consistency</text>
      </g>}
      {plate.kind === 'stability' && <g>
        <path class="soft-line" d="M40 190 H292 M55 200 V50 M350 190 H606 M365 200 V50" />
        <path class="accent-line" d="M70 70 Q160 256 272 70" /><path class="secondary-line" d="M380 175 Q483 8 590 175" />
        <circle class="filled" cx="170" cy="164" r="5" /><circle class="filled-secondary" cx="485" cy="92" r="5" />
        <text x="167" y="30" text-anchor="middle">Positive curvature</text><text x="480" y="30" text-anchor="middle">Negative curvature</text>
        <text x="167" y="227" text-anchor="middle">Locally stable direction</text><text x="480" y="227" text-anchor="middle">A downhill direction exists</text>
      </g>}
      {plate.kind === 'potential' && <g>
        <path class="ink-line" d="M70 30 V205 H590" marker-end={arrow} />
        <path class="accent-line" d="M100 36 C130 212 230 214 300 149 S455 86 575 78" />
        <path class="secondary-line" d="M253 193 L400 83" />
        <circle class="filled" cx="315" cy="137" r="6" />
        <text x="20" y="42">E</text><text x="380" y="236" text-anchor="middle">Nuclear coordinate R</text>
        <text x="390" y="50">Local gradient</text><text x="166" y="156">Minimum</text>
      </g>}
      {plate.kind === 'rotation' && <g>
        <path class="ink-line" d="M90 190 H235 M90 190 V45" marker-end={arrow} />
        <path class="accent-line" d="M390 190 L545 100 M390 190 L325 65" marker-end={arrow} />
        <path class="soft-line" d="M325 190 H560 M390 210 V40" />
        <path class="secondary-line" d="M215 113 H304" marker-end={arrow} />
        <text x="155" y="232" text-anchor="middle">Original coordinates</text><text x="450" y="232" text-anchor="middle">Rotated coordinates</text>
        <text x="320" y="30" text-anchor="middle">Same complete span; a different basis</text>
        <path class="ink-line" d="M445 190 A55 55 0 0 0 438 161" /><text x="465" y="174">angle</text>
      </g>}
      {plate.kind === 'configurations' && <g>
        <path class="soft-line" d="M170 65 L450 65 L320 180 Z M170 65 L320 180" />
        {[{ x: 170, y: 65, text: '1100' }, { x: 450, y: 65, text: '0011' }, { x: 320, y: 180, text: '1001' }].map((item, index) => <g>
          <rect class="tinted" x={item.x - 65} y={item.y - 26} width="130" height="52" rx="4" />
          <text class="data" x={item.x} y={item.y + 7} text-anchor="middle">{item.text}</text>
          <text x={item.x} y={item.y + 50} text-anchor="middle">coefficient c{index + 1}</text>
        </g>)}
        <text x="320" y="43" text-anchor="middle">coupling</text>
      </g>}
      {plate.kind === 'partition' && <g>
        {['Inactive', 'Active', 'Excluded'].map((text, index) => <g>
          <rect class={index === 1 ? 'tinted' : 'paper'} x={28 + index * 205} y="42" width="175" height="160" rx="4" />
          <text x={115 + index * 205} y="78" text-anchor="middle">{text}</text>
          {[0, 1, 2].map(row => <path class={index === 1 ? 'accent-line' : 'soft-line'} d={`M${55 + index * 205} ${107 + row * 32} H${175 + index * 205}`} />)}
          <text class="data" x={115 + index * 205} y="145" text-anchor="middle">{['fixed', 'variable', 'outside'][index]}</text>
        </g>)}
        <text x="320" y="232" text-anchor="middle">Retain ordering, occupations, and energy offsets</text>
      </g>}
      {plate.kind === 'refinement' && <g>
        <rect class="paper" x="28" y="85" width="145" height="65" /><text x="101" y="123" text-anchor="middle">Reference</text>
        <path class="accent-line" d="M174 116 H250 V45 H335 M250 116 H335 M250 116 V203 H335" />
        {['MCSCF: adapt orbitals', 'Correlation correction', 'Effective Hamiltonian'].map((text, index) => <g>
          <rect class={index === 2 ? 'dashed-box' : 'tinted'} x="340" y={18 + index * 79} width="266" height="55" rx="4" />
          <text x="473" y={52 + index * 79} text-anchor="middle">{text}</text>
        </g>)}
        <text x="118" y="216">Dashed: interface</text>
      </g>}
      {plate.kind === 'factorization' && <g>
        {Array.from({ length: 25 }, (_, index) => <rect class={(index % 6) === 0 ? 'filled' : 'tinted'} x={45 + index % 5 * 25} y={57 + Math.floor(index / 5) * 25} width="22" height="22" />)}
        <path class="accent-line" d="M212 119 H305" marker-end={arrow} />
        {[0, 1, 2, 3].map(index => <g>
          <rect class="tinted" x={345 + index * 54} y="58" width="23" height="120" />
          <text x={357 + index * 54} y="203" text-anchor="middle">{index + 1}</text>
        </g>)}
        <text x="105" y="224" text-anchor="middle">Pair-index tensor</text><text x="450" y="234" text-anchor="middle">Factor components</text>
        <text x="320" y="28" text-anchor="middle">A structured numerical representation</text>
      </g>}
      {plate.kind === 'circuit' && <g>
        <path class="ink-line" d="M55 115 H590" />
        <text class="data" x="35" y="120">0</text>
        {[{ x: 135, text: 'H' }, { x: 305, text: 'phase' }, { x: 475, text: 'H' }].map(item => <g>
          <rect class="tinted" x={item.x - 42} y="80" width="84" height="70" rx="4" /><text x={item.x} y="122" text-anchor="middle">{item.text}</text>
        </g>)}
        <path class="ink-line" d="M552 102 Q570 65 588 102 M570 96 L584 81" />
        <text x="320" y="35" text-anchor="middle">Relative phase controls interference</text>
        <text class="data" x="320" y="210" text-anchor="middle">P(0) = cos²(phase / 2)</text>
      </g>}
      {plate.kind === 'parity' && <g>
        <path class="ink-line" d="M70 112 H575" />
        {columns.map((x, index) => <g>
          <circle class={index === 2 ? 'filled' : 'paper'} cx={x} cy="112" r="31" />
          <text class={index === 2 ? 'on-fill data' : 'data'} x={x} y="120" text-anchor="middle">{bits[index]}</text>
          <text x={x} y="173" text-anchor="middle">Mode {index}</text>
        </g>)}
        <path class="secondary-line" d="M75 58 H335" marker-end={arrow} />
        <text x="210" y="33" text-anchor="middle">Count earlier occupations</text><text x="435" y="223" text-anchor="middle">1 earlier electron: sign = -1</text>
      </g>}
      {plate.kind === 'sector' && <g>
        <rect class="tinted" x="45" y="50" width="245" height="135" rx="4" /><rect class="paper" x="350" y="50" width="245" height="135" rx="4" />
        <text x="168" y="85" text-anchor="middle">ZZ eigenvalue +1</text><text x="473" y="85" text-anchor="middle">ZZ eigenvalue -1</text>
        <text class="large-data" x="168" y="144" text-anchor="middle">00  11</text><text class="large-data" x="473" y="144" text-anchor="middle">01  10</text>
        <text x="320" y="227" text-anchor="middle">Choose the physical sector, not merely the smaller label</text>
      </g>}
      {plate.kind === 'overlap' && <g>
        <text x="40" y="52">Illustrative eigenstate weights</text>
        <rect class="filled" x="45" y="82" width="330" height="64" /><rect class="filled-secondary" x="375" y="82" width="140" height="64" /><rect class="tinted" x="515" y="82" width="80" height="64" />
        <text class="on-fill" x="208" y="121" text-anchor="middle">Target component</text>
        <path class="ink-line" d="M45 162 H375 M45 155 V170 M375 155 V170" />
        <text x="210" y="198" text-anchor="middle">Squared overlap, not a guarantee</text><text x="535" y="190" text-anchor="middle">Other states</text>
        <text x="320" y="235" text-anchor="middle">Weights shown are schematic, not scientific results</text>
      </g>}
      {plate.kind === 'decomposition' && <g>
        {[95, 155].map(y => <path class="ink-line" d={`M28 ${y} H610`} />)}
        {[65, 555].map(x => <g><rect class="tinted" x={x - 30} y="65" width="60" height="120" /><text x={x} y="132" text-anchor="middle">B{x === 555 ? '†' : ''}</text></g>)}
        {[190, 445].map(x => <g><path class="accent-line" d={`M${x} 95 V155`} /><circle class="filled" cx={x} cy="95" r="7" /><circle class="paper" cx={x} cy="155" r="15" /><path class="accent-line" d={`M${x - 9} 155 H${x + 9} M${x} 145 V165`} /></g>)}
        <rect class="tinted" x="274" y="125" width="86" height="60" /><text x="317" y="161" text-anchor="middle">Rz</text>
        <text x="320" y="33" text-anchor="middle">Basis change, parity, rotation, reverse</text><text x="320" y="230" text-anchor="middle">Schematic two-mode Pauli exponential</text>
      </g>}
      {plate.kind === 'product' && <g>
        <text x="35" y="56">Target</text><text x="35" y="119">1 step</text><text x="35" y="181">4 steps</text>
        <rect class="paper" x="140" y="26" width="455" height="43" /><text x="368" y="54" text-anchor="middle">exp[-i (A + B) t]</text>
        {[0, 1].map(index => <rect class={index ? 'filled-secondary' : 'filled'} x={140 + index * 227.5} y="88" width="224" height="43" />)}
        <text class="on-fill" x="253" y="117" text-anchor="middle">A</text><text class="on-fill" x="479" y="117" text-anchor="middle">B</text>
        {Array.from({ length: 8 }, (_, index) => <g><rect class={index % 2 ? 'filled-secondary' : 'filled'} x={140 + index * 57} y="151" width="53" height="43" /><text class="on-fill" x={166 + index * 57} y="180" text-anchor="middle">{index % 2 ? 'B' : 'A'}</text></g>)}
        <text x="360" y="235" text-anchor="middle">Noncommuting pieces depend on order</text>
      </g>}
      {plate.kind === 'block' && <g>
        <rect class="paper" x="165" y="30" width="310" height="170" /><path class="soft-line" d="M320 30 V200 M165 115 H475" />
        <rect class="tinted" x="165" y="30" width="155" height="85" />
        <text class="large-data" x="242" y="84" text-anchor="middle">H / λ</text>
        <text class="large-data" x="397" y="84" text-anchor="middle">*</text><text class="large-data" x="242" y="174" text-anchor="middle">*</text><text class="large-data" x="397" y="174" text-anchor="middle">*</text>
        <text x="90" y="124" text-anchor="middle">U =</text><text x="320" y="233" text-anchor="middle">Ancilla-selected block inside a unitary</text>
        <path class="accent-line" d="M548 70 H488" marker-end={arrow} />
      </g>}
      {plate.kind === 'measurement' && <g>
        <text x="170" y="35" text-anchor="middle">Z-basis setting</text><text x="480" y="35" text-anchor="middle">X-basis setting</text>
        <text class="data" x="170" y="76" text-anchor="middle">ZI   IZ   ZZ</text><text class="data" x="480" y="76" text-anchor="middle">XX   XI</text>
        {[45, 90, 55, 115].map((height, index) => <rect class="filled" x={65 + index * 57} y={212 - height} width="37" height={height} />)}
        {[80, 50, 108, 68].map((height, index) => <rect class="filled-secondary" x={375 + index * 57} y={212 - height} width="37" height={height} />)}
        <path class="ink-line" d="M50 212 H290 M360 212 H605" /><text x="320" y="243" text-anchor="middle">Illustrative counts; not a measured dataset</text>
      </g>}
      {plate.kind === 'phase' && <g>
        <circle class="paper" cx="185" cy="125" r="80" />
        {Array.from({ length: 8 }, (_, index) => {
          const angle = index * Math.PI / 4 - Math.PI / 2;
          return <g><path class="soft-line" d={`M185 125 L${185 + 80 * Math.cos(angle)} ${125 + 80 * Math.sin(angle)}`} /><text class="data" x={185 + 103 * Math.cos(angle)} y={131 + 103 * Math.sin(angle)} text-anchor="middle">{index}/8</text></g>;
        })}
        <path class="accent-line" d="M185 125 H260" marker-end={arrow} />
        <text x="400" y="75">3 bits: 8 phase bins</text><text x="400" y="118">0 and 1 coincide</text><text x="400" y="161">Energy needs a scale</text><text x="400" y="204">and an alias choice</text>
      </g>}
      {plate.kind === 'amplification' && <g>
        <path class="ink-line" d="M105 210 H560 M105 210 V28" marker-end={arrow} />
        <path class="soft-line" d="M535 210 A430 430 0 0 0 105 -220" />
        <path class="secondary-line" d="M105 210 L445 150" marker-end={arrow} /><path class="accent-line" d="M105 210 L330 55" marker-end={arrow} />
        <path class="accent-line" d="M259 183 A155 155 0 0 0 232 121" marker-end={arrow} />
        <text x="345" y="45">After reflections</text><text x="457" y="146">Initial</text><text x="90" y="23">Good</text><text x="550" y="238">Bad</text>
        <text x="343" y="225" text-anchor="middle">Axes name the oracle’s subspaces</text>
      </g>}
      {plate.kind === 'driven' && <g>
        <path class="ink-line" d="M60 38 V202 H595" marker-end={arrow} />
        {[0, 1, 2, 3, 4, 5].map(index => <rect class="tinted" x={85 + index * 80} y={105 - 50 * Math.sin(index)} width="75" height={97 + 50 * Math.sin(index)} />)}
        <path class="accent-line" d="M85 122 C165 5 210 55 260 127 S385 216 435 137 S530 35 580 90" />
        <text x="24" y="33">H(t)</text><text x="330" y="234" text-anchor="middle">Time-ordered integration intervals</text>
      </g>}
      {plate.kind === 'lattice' && <g>
        <path class="accent-line" d="M185 60 H455 V185 H185 Z" />
        {[{ x: 185, y: 60 }, { x: 455, y: 60 }, { x: 455, y: 185 }, { x: 185, y: 185 }].map((point, index) => <g>
          <circle class="paper" cx={point.x} cy={point.y} r="27" /><text x={point.x} y={point.y + 6} text-anchor="middle">{index + 1}</text>
        </g>)}
        <text x="320" y="47" text-anchor="middle">hopping t</text><text x="320" y="232" text-anchor="middle">Boundary conditions are part of the model</text>
        <circle class="filled" cx="180" cy="57" r="5" /><circle class="filled-secondary" cx="193" cy="65" r="5" />
        <text x="42" y="83">local U</text><path class="ink-line" d="M104 80 L154 65" />
      </g>}
      {plate.kind === 'execution' && <g>
        <rect class="paper" x="27" y="87" width="150" height="70" /><text x="102" y="128" text-anchor="middle">Circuit</text>
        <path class="accent-line" d="M177 123 H259 V48 H340 M259 123 H340 M259 123 V207 H340" />
        {['Ideal simulation', 'Noise-aware sampling', 'Resource counting'].map((text, index) => <g><rect class={index === 2 ? 'paper' : 'tinted'} x="345" y={20 + index * 79} width="255" height="54" rx="4" /><text x="473" y={54 + index * 79} text-anchor="middle">{text}</text></g>)}
        <text x="170" y="225" text-anchor="middle">Different evidence</text>
      </g>}
      {plate.kind === 'budget' && <g>
        {['Model', 'Approximation', 'Estimation'].map((text, index) => <g>
          <text x="45" y={67 + index * 65}>{text}</text><rect class={index === 1 ? 'filled-secondary' : 'filled'} x="220" y={40 + index * 65} width={[250, 150, 100][index]} height="34" />
        </g>)}
        <path class="ink-line" d="M220 220 H595" /><text x="430" y="244" text-anchor="middle">Illustrative error allowances</text><text x="490" y="62">Sum valid</text><text x="490" y="88">bounds</text>
      </g>}
      {plate.kind === 'workload' && <g>
        {['Circuits', 'Shots', 'Trials', 'Total work'].map((text, index) => <g>
          <rect class={index === 3 ? 'tinted' : 'paper'} x={20 + index * 160} y="72" width="133" height="90" rx="4" /><text x={86 + index * 160} y="123" text-anchor="middle">{text}</text>
          {index < 3 && <text x={166 + index * 160} y="123" text-anchor="middle">{index === 2 ? '=' : '×'}</text>}
        </g>)}
        <text x="320" y="34" text-anchor="middle">Sum each circuit’s cost times its repetitions</text><text x="320" y="214" text-anchor="middle">Peak width is not the sum of serial register widths</text>
      </g>}
      {plate.kind === 'patch' && <g>
        <rect class="paper" x="40" y="82" width="145" height="90" /><text x="112" y="122" text-anchor="middle">1 logical</text><text x="112" y="149" text-anchor="middle">patch</text>
        <path class="accent-line" d="M207 126 H290" marker-end={arrow} />
        {Array.from({ length: 25 }, (_, index) => <circle class={index % 2 ? 'filled-secondary' : 'filled'} cx={350 + index % 5 * 37} cy={42 + Math.floor(index / 5) * 37} r="9" />)}
        <text x="436" y="235" text-anchor="middle">Many physical degrees of freedom</text><text x="110" y="213" text-anchor="middle">Schematic only</text>
      </g>}
      {plate.kind === 'pareto' && <g>
        <path class="ink-line" d="M85 32 V200 H590" marker-end={arrow} />
        <path class="accent-line" d="M130 49 Q145 134 270 164 T568 181" />
        {[{ x: 133, y: 62 }, { x: 184, y: 130 }, { x: 282, y: 168 }, { x: 423, y: 177 }, { x: 558, y: 181 }].map(point => <circle class="filled" cx={point.x} cy={point.y} r="6" />)}
        <circle class="tinted" cx="400" cy="90" r="6" /><text x="420" y="83">Dominated choice</text>
        <text x="35" y="27">Time</text><text x="379" y="235" text-anchor="middle">Physical qubits (illustrative tradeoff)</text>
      </g>}
      {plate.kind === 'provenance' && <g>
        {['Inputs', 'Method', 'Artifact'].map((text, index) => <g>
          <rect class="paper" x={40 + index * 202} y="50" width="155" height="113" rx="4" /><text x={117 + index * 202} y="84" text-anchor="middle">{text}</text>
          {[0, 1, 2].map(row => <path class="soft-line" d={`M${63 + index * 202} ${109 + row * 16} H${171 + index * 202}`} />)}
          {index < 2 && <path class="accent-line" d={`M${195 + index * 202} 113 H${233 + index * 202}`} marker-end={arrow} />}
        </g>)}
        <path class="accent-line" d="M117 172 V202 H521 V172" /><text x="320" y="231" text-anchor="middle">Revision + schema + hash + scientific context</text>
      </g>}
      {plate.kind === 'remote' && <g>
        <rect class="paper" x="30" y="67" width="157" height="92" /><text x="108" y="120" text-anchor="middle">Client job</text>
        <rect class="tinted" x="235" y="45" width="170" height="135" /><text x="320" y="86" text-anchor="middle">Backend</text><text x="320" y="136" text-anchor="middle">Execution</text>
        <rect class="paper" x="454" y="67" width="156" height="92" /><text x="532" y="120" text-anchor="middle">Result</text>
        <path class="accent-line" d="M187 108 H225 M405 108 H444" marker-end={arrow} /><path class="secondary-line" d="M320 187 V218 H108 V169" marker-end={arrow} />
        <text x="425" y="230">Cache identity</text><text x="320" y="23" text-anchor="middle">Status and failure are part of the contract</text>
      </g>}
      {plate.kind === 'interfaces' && <g>
        {['CLI', 'MCP', 'Notebook'].map((text, index) => <g><rect class="paper" x={38 + index * 208} y="30" width="150" height="52" /><text x={113 + index * 208} y="63" text-anchor="middle">{text}</text><path class="accent-line" d={`M${113 + index * 208} 82 V124 H321 V150`} /></g>)}
        <rect class="tinted" x="140" y="151" width="360" height="64" /><text x="320" y="189" text-anchor="middle">Same scientific objects and boundaries</text>
        <text x="320" y="243" text-anchor="middle">An interface is not independent scientific evidence</text>
      </g>}
      {plate.kind === 'layers' && <g>
        {['Python API and workflows', 'Bindings and data contracts', 'C++ core and numerical dependencies', 'Build, tests, platforms, and release'].map((text, index) => <g>
          <rect class={index % 2 ? 'paper' : 'tinted'} x={55 + index * 13} y={20 + index * 54} width={530 - index * 26} height="46" /><text x="320" y={50 + index * 54} text-anchor="middle">{text}</text>
        </g>)}
      </g>}
      {plate.kind === 'review' && <g>
        <path class="accent-line" d="M87 122 H553" />
        {['Question', 'Model', 'Evidence', 'Machine'].map((text, index) => <g>
          <circle class="paper" cx={87 + index * 155} cy="122" r="31" /><path class="accent-line" d={`M${74 + index * 155} 122 l9 10 l18 -24`} />
          <text x={87 + index * 155} y="190" text-anchor="middle">{text}</text>
        </g>)}
        <text x="320" y="43" text-anchor="middle">Every claim has a traceable supporting record</text><text x="320" y="235" text-anchor="middle">Review the complete chain, including its limits</text>
      </g>}
    </svg>
  </div>
  <figcaption id={description}>{plate.caption}</figcaption>
  <ul class="plate-key">{plate.labels.map((text, index) => <li><span class="key-number">{index + 1}</span>{text}</li>)}</ul>
</figure>
