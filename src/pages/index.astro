---
import SiteLayout from '../layouts/SiteLayout.astro';
import { BASE, course, domains, EXPECTED_LESSONS, lessonUrl, readingMinutes } from '../lib/course';
import { learning } from '../data/learning';
---
<SiteLayout wide>
  <div class="home-opening">
    <div>
      <h1>From Molecule<br />to Machine</h1>
      <p class="home-intro">Understand the chemistry. Follow it all the way to the machine. A source-grounded course in electronic structure, quantum algorithms, and the assumptions that connect them.</p>
      <div class="home-actions"><a class="button" href={lessonUrl(1)}>Start with the question <span aria-hidden="true">→</span></a><a data-continue hidden href={lessonUrl(1)}>Continue learning</a></div>
    </div>
    <aside class="course-note" aria-label="How to use this course">
      <h2>Read. Explore. Question.</h2>
      <p>The full technical lessons come first. Diagrams and small experiments help you test your understanding.</p>
      <p>No sign-in, no locked chapters.<br />Your progress stays here.</p>
      <p><a href={`${BASE}about/`}>A note on sources and scope</a></p>
    </aside>
  </div>
  {course.lessons.length !== EXPECTED_LESSONS && <aside class="availability-notice"><p><strong>Course under construction.</strong> {course.lessons.length} complete lessons are available in this preview; the planned course has {EXPECTED_LESSONS}. Missing lessons are not replaced with summaries.</p></aside>}
  <figure class="journey-map">
    <h2>One connected journey</h2>
    <div class="journey-stages">
      {domains.map((domain, index) => <a href={`#${domain.id}`}>
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="19" />
          {index === 0 && <g><circle cx="14" cy="20" r="4" /><circle cx="26" cy="20" r="4" /><path d="M18 20 H22" /></g>}
          {index === 1 && <g><ellipse cx="20" cy="20" rx="12" ry="5" transform="rotate(45 20 20)" /><ellipse cx="20" cy="20" rx="12" ry="5" transform="rotate(-45 20 20)" /></g>}
          {index === 2 && <g><path d="M9 15 H31 M9 25 H31" /><rect x="14" y="11" width="7" height="8" /><circle cx="27" cy="25" r="3" /></g>}
          {index === 3 && <g><path d="M20 8 V32 M8 20 H32" /><circle cx="20" cy="20" r="9" /><path d="M20 20 L26 13" /></g>}
          {index === 4 && <g><path d="M10 28 H30 M13 28 V20 M20 28 V12 M27 28 V17" /></g>}
          {index === 5 && <g><rect x="11" y="10" width="18" height="20" rx="2" /><path d="M15 15 H25 M15 20 H25 M15 25 H21" /></g>}
        </svg>
        <span>{['Ask a question', 'Prepare the model', 'Encode & build', 'Evolve & measure', 'Validate & cost', 'Connect the system'][index]}</span>
      </a>)}
    </div>
    <figcaption>A map of the course, not a claim that every method is a compulsory pipeline stage. Follow the sequence or enter where you need context.</figcaption>
  </figure>
  <div class="curriculum-intro" id="curriculum"><h2>The course, chapter by chapter</h2><p>{course.lessons.length} complete lessons · no prerequisites enforced</p></div>
  {domains.map(domain => <section class="domain-section" id={domain.id} aria-labelledby={`${domain.id}-title`}>
    <div class="domain-description"><h3 id={`${domain.id}-title`}>{domain.title}</h3><p>{domain.description}</p><p class="domain-range">Lessons {domain.range[0]}–{domain.range[1]}</p></div>
    <ol class="lesson-list">
      {course.lessons.filter(lesson => lesson.number >= domain.range[0] && lesson.number <= domain.range[1]).map(lesson => <li>
        <a href={lessonUrl(lesson.number)} data-lesson-link={lesson.number}>
          <span class="lesson-index">{String(lesson.number).padStart(2, '0')}</span>
          <span><strong>{lesson.title}</strong><small>{learning[lesson.number]?.summary}</small><span class="lesson-state" hidden aria-label="Read">✓ Read</span></span>
          <span class="lesson-time">~{readingMinutes(lesson.body)} min</span>
        </a>
      </li>)}
    </ol>
  </section>)}
  <section class="team-handoff"><h2>Keep the boundaries visible</h2><p>These lessons connect chemistry to compiler, resource-estimation, error-correction, and hardware work. They explain what crosses each boundary, not who owns a team internally. Every interactive model states what it leaves out.</p></section>
</SiteLayout>
